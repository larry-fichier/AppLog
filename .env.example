# Configuration de la Base de Données
# Remplacer USER, PASSWORD, HOST avec vos valeurs réelles
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# JWT Secret - Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Doit être une chaîne aléatoire de 64+ caractères
JWT_SECRET=YOUR_SECRET_HERE_REPLACE_WITH_GENERATED_VALUE

# Configuration du Serveur
PORT=3000
NODE_ENV=development

# Email Administrateur
ADMIN_EMAIL=admin@example.com

# Configuration PostgreSQL (Alternative à DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=YOUR_PASSWORD_HERE
PGDATABASE=geslog