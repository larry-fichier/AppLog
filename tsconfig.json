{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react",    "types": ["react"],    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true
  },
  "exclude": [
    "Nouveau dossier",
    "node_modules",
    "dist"
  ]
}
